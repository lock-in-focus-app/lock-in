{
  // The website: static files only, prerendered by `nuxt generate`. No Worker script runs.
  "name": "seiza",
  "compatibility_date": "2026-10-30",
  // Deploying attaches the domain to the Worker, so it doesn't need setting in the dashboard.
  "routes": [{ "pattern": "getseiza.app", "custom_domain": true }],
  "assets": {
    "directory": "./.output/public",
    // Unknown addresses get the 404 page with a 404 status.
    "not_found_handling": "404-page",
    // Pages are served at /privacy rather than /privacy/, matching the site's links and canonical
    // addresses (search engines treat the two as different pages). /privacy/ redirects.
    "html_handling": "drop-trailing-slash",
  },
}
