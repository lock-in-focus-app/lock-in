{
  "name": "@lock-in/extension",
  "description": "Tame, block, or redirect distracting sites during focus sessions.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "LOCK_IN_STORE=1 wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "wxt build && vitest run --config vitest.e2e.config.ts",
    "screenshots": "wxt build && vitest run --config vitest.store.config.ts",
    "postinstall": "wxt prepare",
    "icons": "node icon/render.ts"
  },
  "dependencies": {
    "@lock-in/core": "workspace:*",
    "@lock-in/recipes": "workspace:*",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@wxt-dev/module-vue": "^1.0.3",
    "puppeteer": "^25.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.2.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.3"
  }
}
