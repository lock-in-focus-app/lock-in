{
  "name": "lock-in",
  "private": true,
  "description": "Free, open-source focus app: block, tame, or redirect distractions and watch your night sky fill with stars.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/lock-in-focus-app/lock-in#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lock-in-focus-app/lock-in.git"
  },
  "bugs": "https://github.com/lock-in-focus-app/lock-in/issues",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:extension": "pnpm --filter @lock-in/extension dev",
    "dev:extension:firefox": "pnpm --filter @lock-in/extension dev:firefox",
    "dev:desktop": "pnpm --filter @lock-in/desktop tauri dev",
    "dev:website": "pnpm --filter @lock-in/website dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @lock-in/extension test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
